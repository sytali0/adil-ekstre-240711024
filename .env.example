# ============================================================
#  AdilEkstre (adil-ekstre-240711024) — Ortam Değişkenleri Şablonu
#  Bu dosyayı .env olarak kopyalayın:  cp .env.example .env
#  .env dosyası .gitignore'dadır; ASLA commit etmeyin.
# ============================================================

# ------------------------------------------------------------
# 1) Sohbet Modeli — Tek OpenAI Uyumlu İstemci, Çok Arka Uç
#    Aşağıdaki bloklardan BİRİNİ aktif edin:
# ------------------------------------------------------------

# (a) Google AI Studio — Ücretsiz Gemini Katmanı (aistudio.google.com)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=BURAYA_GEMINI_ANAHTARINIZ
LLM_MODEL=gemini-3.5-flash-lite

# (b) OpenRouter — Ders Kapsamında Verilen Harcama Limitli Anahtar
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=HOCANIN_VERDIGI_ANAHTAR
# LLM_MODEL=openai/gpt-6-luna

# (c) Ollama — Yerel Model, $0 Maliyet (ollama pull qwen3.5:4b)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen3.5:4b

# (d) Çevrimdışı Sahte LLM Sunucusu (python sahte_llm_sunucu.py)
# LLM_BASE_URL=http://localhost:8080/v1
# LLM_API_KEY=sahte
# LLM_MODEL=sahte-model

# ------------------------------------------------------------
# 2) Gömme (Embedding) Modeli — Hibrit RAG
#    Boş bırakılırsa yerel 3-gram + BM25 hibrit indeks kullanılır.
# ------------------------------------------------------------
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=gemini-embedding-001

# ------------------------------------------------------------
# 3) Maliyet ve Bütçe Sınırları
# ------------------------------------------------------------
MAX_ADIM=4
MAX_TOKEN=12000
MAX_USD=0.02
GIRDI_FIYAT=0.10
CIKTI_FIYAT=0.50

# ------------------------------------------------------------
# 4) Opsiyonel İzleme ve Portfolyo Kontrolü
# ------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
GITHUB_TOKEN=
